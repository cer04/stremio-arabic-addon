# Server
PORT=7000
NODE_ENV=production

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600

# TMDB API key for metadata lookup (optional but recommended)
TMDB_API_KEY=

# OMDB API key for metadata lookup (optional)
OMDB_API_KEY=

# Site URLs (update mirrors here without code changes)
AKWAM_URL=https://akwam.to
EGYBEST_URL=https://egybest.show
ARABCITY_URL=https://arabcity.site
WATANFLIX_URL=https://watanflix.com
CIMA4U_URL=https://cima4u.io
MYCIMA_URL=https://mycima.show
FASELHD_URL=https://faselhd.center
EGYDEAD_URL=https://egydead.live

# Logging
LOG_LEVEL=info

# Rate limiting - requests per site per minute
RATE_LIMIT_PER_MINUTE=10

# Max retries for failed scrapes
MAX_RETRIES=3

# Public URL for the deployed addon (used in manifest)
PUBLIC_URL=http://localhost:7000
